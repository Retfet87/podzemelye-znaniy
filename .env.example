MAX_BOT_TOKEN=
# Необязательно. Путь к доверенному сертификату Минцифры в формате PEM.
# MAX_CA_FILE=certificates/russian_trusted_root_ca.pem

# Локальная база. Замени пароль; специальные символы в URL кодируются.
DATABASE_URL=postgresql://podzemelye:REPLACE_ME@127.0.0.1:5432/podzemelye

# Необязательно. Отдельная локальная база для интеграционных тестов.
# TEST_DATABASE_URL=postgresql://podzemelye:REPLACE_ME@127.0.0.1:5432/podzemelye_test

# Необязательно. MAX ID единственного супер-администратора. Храни в локальном .env.
MAX_SUPER_ADMIN_ID=
# Включи отправку из очереди после проверки на отдельном боте и БД.
SCHEDULE_NOTIFICATIONS_ENABLED=0

# Включи напоминания и уведомления о заданиях после проверки бота и БД.
HOMEWORK_NOTIFICATIONS_ENABLED=0

# Включи доставку уведомлений о мероприятиях после проверки.
EVENT_NOTIFICATIONS_ENABLED=0

# Opt-in per-process pool; 0 keeps direct connections. 1..16, benchmark used 4.
DB_POOL_MAX_SIZE=0
